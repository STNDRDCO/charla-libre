# Mismos nombres que Cartel donde aplica. En Vercel: Settings → Environment Variables.

# Supabase → Connect → "Transaction pooler" (puerto 6543). Solo servidor.
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# El dominio público. Se usa en correos y en las instrucciones de webhook del panel.
NEXT_PUBLIC_SITE_URL=https://charlalibre.com.ar

# Administración: https://charlalibre.com.ar/admin/ESTE_VALOR. Generá uno: openssl rand -hex 32
ADMIN_TOKEN=
# A dónde llegan los avisos de charla nueva y los reportes.
ADMIN_EMAIL=

# Correo saliente. Los mismos de Cartel sirven; RESEND_FROM tiene que ser de un dominio verificado en Resend.
RESEND_API_KEY=
RESEND_FROM="Charla Libre <hola@cartel.ar>"
