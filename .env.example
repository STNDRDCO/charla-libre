# Copiá este archivo a .env y completá lo que uses. Todo es opcional salvo BASE_URL en producción.
BASE_URL=https://charlalibre.com
PORT=3000
DB_PATH=./data/charla-libre.db

# Panel de administración (reportes, retirar charlas): https://tu-dominio/admin/ESTE_VALOR
ADMIN_TOKEN=elegí-algo-largo-y-secreto
ADMIN_EMAIL=vos@tu-correo.com

# Correo saliente con Resend (https://resend.com). Sin clave, los correos se imprimen en la consola.
RESEND_API_KEY=
MAIL_DESDE="Charla Libre <hola@charlalibre.com>"

# La primera charla (la tuya). Solo se usa la primera vez que arranca con la base vacía.
KEVIN_EMAIL=vos@tu-correo.com
KEVIN_AGENDA=https://cal.com/tu-usuario/charla-libre
KEVIN_PERFIL=https://www.linkedin.com/in/tu-perfil
KEVIN_DESPUES=
KEVIN_TOKEN=
